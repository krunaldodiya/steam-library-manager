<script>
let state = { games: [], backups: [] };

function showToast(msg) {
  const t = document.getElementById("toast");
  t.innerText = msg;
  t.style.display = "block";
  setTimeout(() => { t.style.display = "none"; }, 4000);
}

function switchTab(t) {
  document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
  document.querySelectorAll(".panel").forEach(p => p.classList.remove("active"));
  if (t === "export") {
    document.querySelectorAll(".tab-btn")[0].classList.add("active");
    document.getElementById("tab-export").classList.add("active");
  } else {
    document.querySelectorAll(".tab-btn")[1].classList.add("active");
    document.getElementById("tab-restore").classList.add("active");
  }
}

async function loadData() {
  const res = await fetch("/api/status");
  state = await res.json();
  renderGames();
  renderBackups();
}

function renderGames() {
  const q = document.getElementById("search-box").value.toLowerCase();
  const tb = document.getElementById("games-list");
  tb.innerHTML = "";
  const filtered = state.games.filter(g => g.name.toLowerCase().includes(q) || g.appid.toString().includes(q));

  if (filtered.length === 0) {
    tb.innerHTML = "<tr><td colspan='5' style='text-align:center;padding:24px;'>No matching games found.</td></tr>";
    return;
  }

  filtered.forEach(g => {
    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td><input type="checkbox" class="game-chk" value="${g.appid}" onchange="updateSelCount()"></td>
      <td style="font-weight:600;color:#fff;">${g.name}</td>
      <td style="color:#8f98a0;">${g.appid}</td>
      <td><span class="badge ${g.installed ? 'installed' : 'library'}">${g.installed ? 'Installed' : 'In Library'}</span></td>
      <td><button class="secondary" style="padding:4px 10px;font-size:12px;" onclick="exportSingle(${g.appid})">Export</button></td>
    `;
    tb.appendChild(tr);
  });
  updateSelCount();
}

function filterGames() { renderGames(); }

function updateSelCount() {
  const count = document.querySelectorAll(".game-chk:checked").length;
  document.getElementById("sel-count").innerText = count;
}

function toggleSelectAll() {
  const chks = document.querySelectorAll(".game-chk");
  const anyUnchecked = Array.from(chks).some(c => !c.checked);
  chks.forEach(c => c.checked = anyUnchecked);
  updateSelCount();
}

function renderBackups() {
  const tb = document.getElementById("backups-list");
  tb.innerHTML = "";
  if (!state.backups || state.backups.length === 0) {
    tb.innerHTML = "<tr><td colspan='5' style='text-align:center;padding:24px;'>No backups found in ~/SteamLibrary-Backups.</td></tr>";
    return;
  }

  state.backups.forEach(b => {
    const tr = document.createElement("tr");
    const dt = new Date(b.mtime * 1000).toLocaleString();
    const sz = (b.size / 1024).toFixed(1) + " KB";
    tr.innerHTML = `
      <td style="font-weight:600;color:#fff;">${b.filename}</td>
      <td>${b.count} games</td>
      <td>${sz}</td>
      <td style="color:#8f98a0;">${dt}</td>
      <td>
        <button class="primary" style="padding:4px 10px;font-size:12px;" onclick="restoreBackup('${b.filename}', 'all')">Restore All</button>
        <button class="secondary" style="padding:4px 10px;font-size:12px;margin-left:6px;" onclick="restoreSelectivePrompt('${b.filename}')">Selective</button>
      </td>
    `;
    tb.appendChild(tr);
  });
}

async function exportSingle(aid) {
  const res = await fetch("/api/export", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({ appids: [aid] })
  });
  const data = await res.json();
  if (data.success) {
    showToast(`✓ Exported ${data.count} game to ${data.backup_name}`);
    loadData();
  } else {
    alert("Export failed: " + data.error);
  }
}

async function exportSelected() {
  const sel = Array.from(document.querySelectorAll(".game-chk:checked")).map(c => parseInt(c.value));
  if (sel.length === 0) {
    alert("Please select at least one game.");
    return;
  }
  const res = await fetch("/api/export", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({ appids: sel })
  });
  const data = await res.json();
  if (data.success) {
    showToast(`✓ Exported ${data.count} selected games to ${data.backup_name}`);
    loadData();
  } else {
    alert("Export failed: " + data.error);
  }
}

async function exportAll() {
  const res = await fetch("/api/export", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({ appids: "all" })
  });
  const data = await res.json();
  if (data.success) {
    showToast(`✓ Backed up whole library (${data.count} games) to ${data.backup_name}`);
    loadData();
  } else {
    alert("Export failed: " + data.error);
  }
}

async function restoreBackup(filename, mode, appids=null) {
  const req = { backup_filename: filename, appids: appids || "all" };
  const res = await fetch("/api/restore", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify(req)
  });
  const data = await res.json();
  if (data.success) {
    showToast(`✓ Restored ${data.restored_count} games! Restart Steam to refresh.`);
    loadData();
  } else {
    alert("Restore failed: " + data.error);
  }
}

function restoreSelectivePrompt(filename) {
  const b = state.backups.find(x => x.filename === filename);
  if (!b || !b.games || b.games.length === 0) {
    alert("No game metadata found in archive.");
    return;
  }
  const listStr = b.games.map((g, idx) => `${idx + 1}. [AppID: ${g.appid}] ${g.name}`).join("\\n");
  const choice = prompt("Enter AppIDs to restore separated by commas (or leave blank to restore all):\\n\\n" + listStr);
  if (choice === null) return;
  if (choice.trim() === "") {
    restoreBackup(filename, "all");
  } else {
    const aids = choice.split(",").map(s => parseInt(s.trim())).filter(n => !isNaN(n));
    if (aids.length > 0) {
      restoreBackup(filename, "selective", aids);
    }
  }
}

window.onload = loadData;
</script>
</body>
</html>"""
            self.wfile.write(html.encode("utf-8"))

        def do_POST(self):
            parsed = urllib.parse.urlparse(self.path)
            length = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(length).decode('utf-8')
            try:
                payload = json.loads(body) if body else {}
            except Exception:
                payload = {}

            if parsed.path == "/api/export":
                appids = payload.get("appids")
                name = payload.get("backup_name")
                result = export_games(appids=appids, backup_name=name)
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps(result).encode("utf-8"))

            elif parsed.path == "/api/restore":
                filename = payload.get("backup_filename")
                bpath = os.path.join(DEFAULT_BACKUP_DIR, filename) if filename else None
                appids = payload.get("appids")
                result = restore_games(backup_path=bpath, appids=appids)
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps(result).encode("utf-8"))
            else:
                self.send_response(404)
                self.end_headers()

    server = http.server.HTTPServer(("127.0.0.1", port), RequestHandler)
    url = f"http://127.0.0.1:{port}"
    print(f"\n🚀 Steam Library Manager GUI is running at: {url}")
    print("Press Ctrl+C to close.")
    try:
        webbrowser.open(url)
    except Exception:
        pass
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nGUI Server stopped.")

def main():
    parser = argparse.ArgumentParser(description="Steam Library Manager - Backup and Restore SLSsteam/LuaTools games")
    subparsers = parser.add_subparsers(dest="command")

    # list
    subparsers.add_parser("list", help="List all managed games")

    # export
    p_export = subparsers.add_parser("export", help="Export/backup games metadata")
    p_export.add_argument("--all", action="store_true", help="Export whole library")
    p_export.add_argument("--games", type=str, help="Comma-separated AppIDs to export (e.g. 1174180,814380)")
    p_export.add_argument("--game", type=int, help="Single AppID to export")
    p_export.add_argument("--name", type=str, help="Custom backup file name")
    p_export.add_argument("--out", type=str, default=DEFAULT_BACKUP_DIR, help="Backup output directory")

    # backups
    subparsers.add_parser("backups", help="List all available backups")

    # restore
    p_restore = subparsers.add_parser("restore", help="Restore games from backup")
    p_restore.add_argument("--backup", type=str, help="Path or filename of backup archive")
    p_restore.add_argument("--all", action="store_true", help="Restore all games from the backup")
    p_restore.add_argument("--games", type=str, help="Comma-separated AppIDs to restore")
    p_restore.add_argument("--game", type=int, help="Single AppID to restore")
    p_restore.add_argument("--file", type=str, help="Import a single .lua file directly")

    # gui
    subparsers.add_parser("gui", help="Open local web GUI in browser")

    args = parser.parse_args()

    if not args.command or args.command == "list":
        games = get_managed_games()
        print(f"\n🎮 Managed Steam Games ({len(games)} total):")
        print("─" * 70)
        for g in games:
            st = "INSTALLED" if g["installed"] else "IN LIBRARY (DOWNLOADABLE)"
            print(f"[{g['appid']:7d}] {g['name']:<42} [{st}]")
        print("─" * 70)
        print(f"Metadata location: {DEFAULT_STPLUG_DIR}")
        return

    if args.command == "export":
        appids = None
        if args.all:
            appids = "all"
        elif args.games:
            appids = [int(x.strip()) for x in args.games.split(",") if x.strip()]
        elif args.game:
            appids = [args.game]
        else:
            print("Please specify --all, --games <id1,id2>, or --game <id>.")
            return

        res = export_games(appids=appids, backup_name=args.name, backup_dir=args.out)
        if res["success"]:
            print(f"\n✓ Successfully exported {res['count']} game(s) to:")
            print(f"  {res['path']}")
        else:
            print(f"\n✗ Export failed: {res['error']}")

    elif args.command == "backups":
        b_list = list_backups()
        print(f"\n📦 Available Backups in {DEFAULT_BACKUP_DIR}:")
        print("─" * 70)
        if not b_list:
            print("No backups found.")
        for b in b_list:
            dt = datetime.fromtimestamp(b["mtime"]).strftime("%Y-%m-%d %H:%M:%S")
            sz = f"{b['size'] / 1024:.1f} KB"
            print(f"{b['filename']:<45} {b['count']:2d} games | {sz} | {dt}")
        print("─" * 70)

    elif args.command == "restore":
        if args.file:
            res = import_single_file(args.file)
            if res["success"]:
                print(f"\n✓ Imported {res['name']} ({res['appid']}) into stplug-in!")
                print("  Restart Steam to refresh your library.")
            else:
                print(f"\n✗ Import failed: {res['error']}")
            return

        appids = None
        if args.all:
            appids = "all"
        elif args.games:
            appids = [int(x.strip()) for x in args.games.split(",") if x.strip()]
        elif args.game:
            appids = [args.game]

        bpath = args.backup
        if bpath and not os.path.isabs(bpath) and not os.path.exists(bpath):
            bpath = os.path.join(DEFAULT_BACKUP_DIR, bpath)

        res = restore_games(backup_path=bpath, appids=appids)
        if res["success"]:
            print(f"\n✓ Successfully restored {res['restored_count']} game(s) from:")
            print(f"  {res['backup_path']}")
            for g in res["games"]:
                print(f"  + [{g['appid']}] {g['name']}")
            print("\n→ Restart Steam to refresh your library.")
        else:
            print(f"\n✗ Restore failed: {res['error']}")

    elif args.command == "gui":
        start_gui_server()

if __name__ == "__main__":
    main()
