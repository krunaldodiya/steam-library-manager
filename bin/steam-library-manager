#!/usr/bin/env python3
"""
Steam Library Manager
Universal Steam game metadata backup & restore (Purchased, Installed, & LuaTools/SLSsteam unlocked).
100% Dynamic Game Title Detection directly from the user's Steam client.
Zero hardcoded games.
"""

import os
import sys
import glob
import re
import json
import time
import shutil
import zipfile
import argparse
import threading
import subprocess
import http.server
import urllib.parse
from datetime import datetime
from pathlib import Path

DEFAULT_STEAM_ROOT = os.path.expanduser("~/.local/share/Steam")
DEFAULT_STPLUG_DIR = os.path.join(DEFAULT_STEAM_ROOT, "config/stplug-in")
DEFAULT_SLS_DIR = os.path.expanduser("~/.config/SLSsteam")
DEFAULT_BACKUP_DIR = os.path.expanduser("~/SteamLibrary-Backups")
NAMES_CACHE_FILE = os.path.expanduser("~/.config/steam-library-manager/names_cache.json")
REPO_DIR = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))

def get_steam_libraries():
    roots = [DEFAULT_STEAM_ROOT]
    vdf = os.path.join(DEFAULT_STEAM_ROOT, "steamapps/libraryfolders.vdf")
    if os.path.exists(vdf):
        try:
            with open(vdf, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read()
            paths = re.findall(r'"path"\s+"([^"]+)"', content)
            for p in paths:
                if p not in roots and os.path.exists(p):
                    roots.append(p)
        except Exception:
            pass
    return roots

def load_names_cache():
    if os.path.exists(NAMES_CACHE_FILE):
        try:
            with open(NAMES_CACHE_FILE, "r", encoding="utf-8") as f:
                return {int(k): v for k, v in json.load(f).items()}
        except Exception:
            pass
    return {}

def save_names_cache(cache):
    os.makedirs(os.path.dirname(NAMES_CACHE_FILE), exist_ok=True)
    try:
        with open(NAMES_CACHE_FILE, "w", encoding="utf-8") as f:
            json.dump({str(k): v for k, v in cache.items()}, f, indent=2)
    except Exception:
        pass

def fetch_live_names_from_steam():
    names = {}
    port_file = os.path.expanduser("~/.local/share/Lumen/cef_port")
    port = None
    if os.path.exists(port_file):
        try:
            with open(port_file, "r") as f:
                port = f.read().split("\n")[0].strip()
        except Exception:
            pass
    if not port:
        try:
            out = subprocess.check_output(["pgrep", "-a", "steamwebhelper"]).decode()
            m = re.search(r'--remote-debugging-port=(\d+)', out)
            if m:
                port = m.group(1)
        except Exception:
            pass
    if not port:
        return names

    node_code = f"""
    const fs = require('fs');
    async function run() {{
        try {{
            const res = await fetch('http://127.0.0.1:{port}/json');
            const pages = await res.json();
            const shared = pages.find(p => p.title === 'SharedJSContext');
            if (!shared) return process.exit(1);
            const ws = new WebSocket(shared.webSocketDebuggerUrl);
            ws.onopen = () => {{
                ws.send(JSON.stringify({{
                    id: 1,
                    method: 'Runtime.evaluate',
                    params: {{
                        expression: `
                            (function() {{
                                const games = {{}};
                                if (window.appStore && window.appStore.m_mapApps) {{
                                    for (const [aid, app] of window.appStore.m_mapApps) {{
                                        if (app.app_type === 1 && app.display_name) {{
                                            games[aid] = app.display_name;
                                        }}
                                    }}
                                }}
                                return games;
                            }})()
                        `,
                        returnByValue: true
                    }}
                }}));
            }};
            ws.onmessage = (e) => {{
                const val = JSON.parse(e.data).result.result.value;
                console.log(JSON.stringify(val));
                process.exit(0);
            }};
            ws.onerror = () => process.exit(1);
        }} catch(e) {{
            process.exit(1);
        }}
    }}
    run();
    """
    try:
        out = subprocess.run(["node", "-e", node_code], capture_output=True, text=True, timeout=2)
        if out.returncode == 0 and out.stdout.strip():
            data = json.loads(out.stdout.strip())
            for k, v in data.items():
                if v and str(v).strip():
                    names[int(k)] = v
    except Exception:
        pass
    return names

def resolve_all_dynamic_names():
    names = load_names_cache()

    # 1. Fetch live game titles directly from running Steam client (app_type === 1)
    live = fetch_live_names_from_steam()
    if live:
        names.update(live)

    # 2. Scan ACF manifests on disk in all Steam library folders
    roots = get_steam_libraries()
    for r in set(roots):
        for acf in glob.glob(os.path.join(r, "steamapps/appmanifest_*.acf")):
            try:
                with open(acf, "r", encoding="utf-8", errors="ignore") as f:
                    txt = f.read()
                aid = re.search(r'"appid"\s+"(\d+)"', txt)
                mname = re.search(r'"name"\s+"([^"]+)"', txt)
                if aid and mname:
                    a = int(aid.group(1))
                    if a not in [228980, 1493710, 4183110]:
                        if a not in names:
                            names[a] = mname.group(1)
            except Exception:
                pass

    save_names_cache(names)
    return names

def get_all_library_games():
    names = resolve_all_dynamic_names()
    games_map = {}
    roots = get_steam_libraries()

    # 1. Scan physical installations
    for r in set(roots):
        for acf in glob.glob(os.path.join(r, "steamapps/appmanifest_*.acf")):
            try:
                with open(acf, "r", encoding="utf-8", errors="ignore") as txt_f:
                    txt = txt_f.read()
                aid = re.search(r'"appid"\s+"(\d+)"', txt)
                name = re.search(r'"name"\s+"([^"]+)"', txt)
                inst_dir = re.search(r'"installdir"\s+"([^"]+)"', txt)
                sz = re.search(r'"SizeOnDisk"\s+"(\d+)"', txt)
                buildid = re.search(r'"buildid"\s+"([^"]+)"', txt)

                if aid and name:
                    a = int(aid.group(1))
                    if a in [228980, 1493710, 4183110]:
                        continue
                    display_name = names.get(a, name.group(1))
                    names[a] = display_name
                    games_map[a] = {
                        "appid": a,
                        "name": display_name,
                        "installed": True,
                        "installdir": inst_dir.group(1) if inst_dir else "",
                        "size_on_disk": int(sz.group(1)) if sz else 0,
                        "buildid": buildid.group(1) if buildid else "",
                        "acf_path": acf,
                        "library_path": r,
                        "has_acf": True,
                        "has_lua": False,
                        "source": "Official Steam"
                    }
            except Exception:
                pass

    # 2. Scan stplug-in for LuaTools manifests
    if os.path.exists(DEFAULT_STPLUG_DIR):
        for f in os.listdir(DEFAULT_STPLUG_DIR):
            if not f.endswith(".lua"):
                continue
            try:
                a = int(f[:-4])
            except ValueError:
                continue

            gname = names.get(a, f"AppID {a}")
            lpath = os.path.join(DEFAULT_STPLUG_DIR, f)
            depots = []
            try:
                with open(lpath, "r", encoding="utf-8", errors="ignore") as lf:
                    ltext = lf.read()
                depots = [int(d) for d in re.findall(r'addappid\((\d+)', ltext)]
            except Exception:
                pass

            if a not in games_map:
                games_map[a] = {
                    "appid": a,
                    "name": gname,
                    "installed": False,
                    "size_on_disk": 0,
                    "has_acf": False,
                    "has_lua": True,
                    "lua_file": f,
                    "depots": depots,
                    "source": "LuaTools / SLSsteam"
                }
            else:
                games_map[a]["has_lua"] = True
                games_map[a]["lua_file"] = f
                games_map[a]["depots"] = depots
                games_map[a]["source"] = "Official / LuaTools"

    # 3. Add known account games dynamically discovered from user's Steam client
    for a, gname in names.items():
        if a not in games_map and a not in [228980, 1493710, 4183110]:
            games_map[a] = {
                "appid": a,
                "name": gname,
                "installed": False,
                "size_on_disk": 0,
                "has_acf": False,
                "has_lua": False,
                "source": "Official Steam Account"
            }

    return [games_map[k] for k in sorted(games_map.keys(), key=lambda x: str(games_map[x]["name"]).lower())]

def export_games(appids=None, backup_name=None, backup_dir=DEFAULT_BACKUP_DIR):
    all_games = get_all_library_games()
    if not all_games:
        return {"success": False, "error": "No games found in Steam library"}

    if appids is None or appids == "all":
        selected_games = all_games
    else:
        req_set = set(int(a) for a in appids)
        selected_games = [g for g in all_games if g["appid"] in req_set]

    if not selected_games:
        return {"success": False, "error": "No matching games selected to export"}

    os.makedirs(backup_dir, exist_ok=True)
    ts = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    if not backup_name:
        if len(selected_games) == 1:
            clean_name = re.sub(r'[^a-zA-Z0-9_\-]', '_', str(selected_games[0]["name"]))
            backup_name = f"game_{selected_games[0]['appid']}_{clean_name}_{ts}.zip"
        elif len(selected_games) == len(all_games):
            backup_name = f"steam_library_full_{ts}.zip"
        else:
            backup_name = f"steam_library_{len(selected_games)}_games_{ts}.zip"

    if not backup_name.endswith(".zip"):
        backup_name += ".zip"

    zip_path = os.path.join(backup_dir, backup_name)
    metadata = {
        "version": "2.0",
        "created_at": ts,
        "total_games": len(selected_games),
        "games": selected_games
    }

    manifests_dir = os.path.join(DEFAULT_SLS_DIR, "manifests")
    all_depots = set()
    for g in selected_games:
        for d in g.get("depots", []):
            all_depots.add(d)

    with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as zf:
        zf.writestr("metadata.json", json.dumps(metadata, indent=2))

        for g in selected_games:
            if g.get("has_lua") and g.get("lua_file"):
                src = os.path.join(DEFAULT_STPLUG_DIR, g["lua_file"])
                if os.path.exists(src):
                    zf.write(src, f"stplug-in/{g['lua_file']}")

            if g.get("has_acf") and g.get("acf_path"):
                if os.path.exists(g["acf_path"]):
                    fname = os.path.basename(g["acf_path"])
                    zf.write(g["acf_path"], f"acfs/{fname}")

        if os.path.exists(manifests_dir) and all_depots:
            for mfile in os.listdir(manifests_dir):
                m_match = re.match(r"^(\d+)_\d+\.manifest$", mfile)
                if m_match and int(m_match.group(1)) in all_depots:
                    msrc = os.path.join(manifests_dir, mfile)
                    zf.write(msrc, f"manifests/{mfile}")

        lat = os.path.join(DEFAULT_SLS_DIR, "library-added-times.txt")
        if os.path.exists(lat):
            zf.write(lat, "sls/library-added-times.txt")

    # Update latest mirror
    mirror_dir = os.path.join(backup_dir, "latest")
    os.makedirs(os.path.join(mirror_dir, "stplug-in"), exist_ok=True)
    os.makedirs(os.path.join(mirror_dir, "acfs"), exist_ok=True)
    for g in selected_games:
        if g.get("has_lua") and g.get("lua_file"):
            src = os.path.join(DEFAULT_STPLUG_DIR, g["lua_file"])
            if os.path.exists(src):
                shutil.copy2(src, os.path.join(mirror_dir, "stplug-in", g["lua_file"]))
        if g.get("has_acf") and g.get("acf_path") and os.path.exists(g["acf_path"]):
            fname = os.path.basename(g["acf_path"])
            shutil.copy2(g["acf_path"], os.path.join(mirror_dir, "acfs", fname))

    with open(os.path.join(mirror_dir, "metadata.json"), "w") as mf:
        json.dump(metadata, mf, indent=2)

    return {
        "success": True,
        "path": zip_path,
        "backup_name": backup_name,
        "count": len(selected_games),
        "games": selected_games
    }

def list_backups(backup_dir=DEFAULT_BACKUP_DIR):
    if not os.path.exists(backup_dir):
        return []
    names = resolve_all_dynamic_names()
    backups = []
    for f in sorted(os.listdir(backup_dir), reverse=True):
        if not f.endswith(".zip"):
            continue
        p = os.path.join(backup_dir, f)
        size = os.path.getsize(p)
        mtime = os.path.getmtime(p)
        games_list = []
        try:
            with zipfile.ZipFile(p, "r") as zf:
                if "metadata.json" in zf.namelist():
                    meta = json.loads(zf.read("metadata.json").decode("utf-8"))
                    games_list = meta.get("games", [])
                else:
                    for n in zf.namelist():
                        if n.startswith("stplug-in/") and n.endswith(".lua"):
                            aid = int(n[10:-4])
                            games_list.append({"appid": aid, "name": names.get(aid, f"AppID {aid}")})
                        elif n.startswith("acfs/appmanifest_") and n.endswith(".acf"):
                            aid = int(n[17:-4])
                            games_list.append({"appid": aid, "name": names.get(aid, f"AppID {aid}")})
        except Exception:
            pass

        backups.append({
            "filename": f,
            "path": p,
            "size": size,
            "mtime": mtime,
            "count": len(games_list),
            "games": games_list
        })
    return backups

def delete_backup(filename_or_path, backup_dir=DEFAULT_BACKUP_DIR):
    if not filename_or_path:
        return {"success": False, "error": "No filename specified"}
    fname = os.path.basename(filename_or_path)
    target = os.path.join(backup_dir, fname)
    if not os.path.exists(target):
        return {"success": False, "error": f"Backup file not found: {fname}"}
    try:
        os.remove(target)
        return {"success": True, "filename": fname}
    except Exception as e:
        return {"success": False, "error": str(e)}

def restore_games(backup_path=None, appids=None, backup_dir=DEFAULT_BACKUP_DIR):
    if not backup_path:
        all_b = list_backups(backup_dir)
        if not all_b:
            return {"success": False, "error": "No backup files found to restore from"}
        backup_path = all_b[0]["path"]

    if not os.path.exists(backup_path):
        return {"success": False, "error": f"Backup file not found: {backup_path}"}

    names = resolve_all_dynamic_names()
    os.makedirs(DEFAULT_STPLUG_DIR, exist_ok=True)
    manifests_dir = os.path.join(DEFAULT_SLS_DIR, "manifests")
    os.makedirs(manifests_dir, exist_ok=True)
    steamapps_dir = os.path.join(DEFAULT_STEAM_ROOT, "steamapps")
    os.makedirs(steamapps_dir, exist_ok=True)

    restored = []
    with zipfile.ZipFile(backup_path, "r") as zf:
        namelist = zf.namelist()
        meta = {}
        if "metadata.json" in namelist:
            try:
                meta = json.loads(zf.read("metadata.json").decode("utf-8"))
            except Exception:
                pass

        available_games = meta.get("games", [])
        avail_map = {g["appid"]: g for g in available_games}

        target_appids = None
        if appids is not None and appids != "all":
            target_appids = set(int(a) for a in appids)

        for member in namelist:
            if member.startswith("stplug-in/") and member.endswith(".lua"):
                fname = os.path.basename(member)
                try:
                    aid = int(fname[:-4])
                except ValueError:
                    continue
                if target_appids is not None and aid not in target_appids:
                    continue

                dest = os.path.join(DEFAULT_STPLUG_DIR, fname)
                with open(dest, "wb") as f:
                    f.write(zf.read(member))

                g_info = avail_map.get(aid, {"appid": aid, "name": names.get(aid, f"AppID {aid}")})
                if g_info not in restored:
                    restored.append(g_info)

            elif member.startswith("acfs/") and member.endswith(".acf"):
                fname = os.path.basename(member)
                aid_match = re.search(r"appmanifest_(\d+)\.acf", fname)
                if aid_match:
                    aid = int(aid_match.group(1))
                    if target_appids is not None and aid not in target_appids:
                        continue

                    target_lib = steamapps_dir
                    if aid in avail_map and avail_map[aid].get("library_path"):
                        lib_p = avail_map[aid]["library_path"]
                        if os.path.exists(lib_p):
                            target_lib = os.path.join(lib_p, "steamapps")

                    dest = os.path.join(target_lib, fname)
                    with open(dest, "wb") as f:
                        f.write(zf.read(member))

                    g_info = avail_map.get(aid, {"appid": aid, "name": names.get(aid, f"AppID {aid}")})
                    if g_info not in restored:
                        restored.append(g_info)

            elif member.startswith("manifests/") and member.endswith(".manifest"):
                fname = os.path.basename(member)
                dest = os.path.join(manifests_dir, fname)
                with open(dest, "wb") as f:
                    f.write(zf.read(member))

            elif member == "sls/library-added-times.txt":
                dest = os.path.join(DEFAULT_SLS_DIR, "library-added-times.txt")
                if not os.path.exists(dest):
                    with open(dest, "wb") as f:
                        f.write(zf.read(member))

    return {
        "success": True,
        "restored_count": len(restored),
        "games": restored,
        "backup_path": backup_path
    }

def import_single_file(file_path):
    if not os.path.exists(file_path):
        return {"success": False, "error": f"File not found: {file_path}"}

    names = resolve_all_dynamic_names()
    fname = os.path.basename(file_path)
    if fname.endswith(".lua"):
        dest = os.path.join(DEFAULT_STPLUG_DIR, fname)
        os.makedirs(DEFAULT_STPLUG_DIR, exist_ok=True)
        shutil.copy2(file_path, dest)
        try:
            aid = int(fname[:-4])
            name = names.get(aid, f"AppID {aid}")
        except Exception:
            aid, name = 0, fname
        return {"success": True, "appid": aid, "name": name, "dest": dest, "type": "Lua Manifest"}

    elif fname.startswith("appmanifest_") and fname.endswith(".acf"):
        dest = os.path.join(DEFAULT_STEAM_ROOT, "steamapps", fname)
        os.makedirs(os.path.join(DEFAULT_STEAM_ROOT, "steamapps"), exist_ok=True)
        shutil.copy2(file_path, dest)
        aid_m = re.search(r"appmanifest_(\d+)\.acf", fname)
        aid = int(aid_m.group(1)) if aid_m else 0
        name = names.get(aid, f"AppID {aid}")
        return {"success": True, "appid": aid, "name": name, "dest": dest, "type": "Steam App Manifest"}

    return {"success": False, "error": "Only .lua manifest scripts or appmanifest_*.acf files can be imported"}

# Standalone Steam In-Memory Injector
def inject_into_steam():
    port_file = os.path.expanduser("~/.local/share/Lumen/cef_port")
    port = None
    if os.path.exists(port_file):
        try:
            with open(port_file, "r") as f:
                port = f.read().split("\n")[0].strip()
        except Exception:
            pass

    if not port:
        try:
            out = subprocess.check_output(["pgrep", "-a", "steamwebhelper"]).decode()
            m = re.search(r'--remote-debugging-port=(\d+)', out)
            if m:
                port = m.group(1)
        except Exception:
            pass

    if not port:
        return False, "Could not locate Steam remote debugging port"

    node_script = f"""
    const fs = require('fs');
    const path = '{REPO_DIR}';
    const css = fs.readFileSync(path + '/frontend/styles.css', 'utf8');
    const js = fs.readFileSync(path + '/frontend/index.js', 'utf8');

    async function run() {{
      const res = await fetch('http://127.0.0.1:{port}/json');
      const pages = await res.json();
      const steam = pages.find(p => p.title === 'Steam');
      if (!steam) return process.exit(1);

      const ws = new WebSocket(steam.webSocketDebuggerUrl);
      ws.onopen = () => {{
        const code = `
          (function() {{
            const oldStyles = document.getElementById('slm-styles');
            if (oldStyles) oldStyles.remove();
            const s = document.createElement('style');
            s.id = 'slm-styles';
            s.textContent = ${{JSON.stringify(css)}};
            document.head.appendChild(s);
            ${{js}}
            return true;
          }})()
        `;
        ws.send(JSON.stringify({{ id: 1, method: 'Runtime.evaluate', params: {{ expression: code, returnByValue: true }} }}));
      }};
      ws.onmessage = () => process.exit(0);
      ws.onerror = () => process.exit(1);
    }}
    run();
    """
    try:
        res = subprocess.run(["node", "-e", node_script], capture_output=True, timeout=5)
        return res.returncode == 0, "Injected"
    except Exception as e:
        return False, str(e)

# HTTP Request Handler with CORS
class RequestHandler(http.server.BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def send_cors_headers(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")

    def do_OPTIONS(self):
        self.send_response(200)
        self.send_cors_headers()
        self.end_headers()

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path in ["/api/games", "/api/status"]:
            games = get_all_library_games()
            backups = list_backups()
            data = {"success": True, "games": games, "backups": backups, "total": len(games)}
            self.send_response(200)
            self.send_cors_headers()
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(data).encode("utf-8"))
            return

        elif parsed.path == "/api/backups":
            backups = list_backups()
            data = {"success": True, "backups": backups}
            self.send_response(200)
            self.send_cors_headers()
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(data).encode("utf-8"))
            return

        self.send_response(200)
        self.send_cors_headers()
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()
        html = f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Steam Library Manager</title>
<style>
  :root {{ --bg: #171a21; --accent: #1a9fff; --text: #c7d5e0; }}
  body {{ background: var(--bg); color: var(--text); font-family: -apple-system, sans-serif; padding: 24px; }}
  button {{ background: var(--accent); border: none; color: #fff; padding: 8px 16px; border-radius: 4px; font-weight: 600; cursor: pointer; }}
</style>
</head>
<body>
  <h1>🎮 Steam Library Manager</h1>
  <p>Universal backup daemon for all Steam games is running (100% dynamic title detection directly from Steam client).</p>
  <button onclick="fetch('/api/export', {{method:'POST', body:JSON.stringify({{appids:'all'}})}}).then(()=>alert('Backed up all games!'))">💾 Backup Whole Library</button>
</body>
</html>"""
        self.wfile.write(html.encode("utf-8"))

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        length = int(self.headers.get('Content-Length', 0))
        body = self.rfile.read(length).decode('utf-8')
        try:
            payload = json.loads(body) if body else {}
        except Exception:
            payload = {}

        if parsed.path in ["/api/games", "/api/get_games"]:
            result = {"success": True, "games": get_all_library_games()}
        elif parsed.path in ["/api/backups", "/api/get_backups"]:
            result = {"success": True, "backups": list_backups()}
        elif parsed.path in ["/api/export", "/api/export_games"]:
            appids = payload.get("appids")
            name = payload.get("backup_name") or payload.get("name")
            result = export_games(appids=appids, backup_name=name)
        elif parsed.path in ["/api/restore", "/api/restore_games"]:
            filename = payload.get("backup_filename")
            bpath = payload.get("backup_path") or (os.path.join(DEFAULT_BACKUP_DIR, filename) if filename else None)
            appids = payload.get("appids")
            result = restore_games(backup_path=bpath, appids=appids)
        elif parsed.path in ["/api/delete_backup", "/api/delete"]:
            filename = payload.get("filename") or payload.get("backup_filename")
            result = delete_backup(filename)
        elif parsed.path == "/api/inject":
            ok, msg = inject_into_steam()
            result = {"success": ok, "message": msg}
        else:
            self.send_response(404)
            self.end_headers()
            return

        self.send_response(200)
        self.send_cors_headers()
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(json.dumps(result).encode("utf-8"))

def run_server(port=8343):
    server = http.server.HTTPServer(("127.0.0.1", port), RequestHandler)
    server.serve_forever()

def run_daemon(port=8343):
    print(f"[SLM Daemon] Starting dynamic API service on 127.0.0.1:{port}...")
    t = threading.Thread(target=run_server, args=(port,), daemon=True)
    t.start()

    last_injected = 0
    while True:
        try:
            time.sleep(3)
            now = time.time()
            if now - last_injected > 5:
                ok, _ = inject_into_steam()
                if ok:
                    last_injected = now
        except KeyboardInterrupt:
            break
        except Exception:
            pass

def main():
    parser = argparse.ArgumentParser(description="Steam Library Manager - Backup and Restore all Steam games (Dynamic)")
    subparsers = parser.add_subparsers(dest="command")

    subparsers.add_parser("list", help="List all Steam games in library")

    p_export = subparsers.add_parser("export", help="Export/backup games metadata")
    p_export.add_argument("--all", action="store_true", help="Export whole library")
    p_export.add_argument("--games", type=str, help="Comma-separated AppIDs to export")
    p_export.add_argument("--game", type=int, help="Single AppID to export")
    p_export.add_argument("--name", type=str, help="Custom backup file name")
    p_export.add_argument("--out", type=str, default=DEFAULT_BACKUP_DIR, help="Backup output directory")

    subparsers.add_parser("backups", help="List all available backups")

    p_del = subparsers.add_parser("delete", help="Delete a backup file")
    p_del.add_argument("filename", help="Backup filename to delete")

    p_restore = subparsers.add_parser("restore", help="Restore games from backup")
    p_restore.add_argument("--backup", type=str, help="Path or filename of backup archive")
    p_restore.add_argument("--all", action="store_true", help="Restore all games from the backup")
    p_restore.add_argument("--games", type=str, help="Comma-separated AppIDs to restore")
    p_restore.add_argument("--game", type=int, help="Single AppID to restore")
    p_restore.add_argument("--file", type=str, help="Import a single .lua or appmanifest_*.acf file directly")

    subparsers.add_parser("inject", help="Inject floating button & UI into running Steam")
    subparsers.add_parser("daemon", help="Run background universal daemon & auto-injector")
    subparsers.add_parser("gui", help="Open local web GUI in browser")

    args = parser.parse_args()

    if not args.command or args.command == "list":
        games = get_all_library_games()
        print(f"\n🎮 Universal Steam Games Library ({len(games)} total, 100% dynamic):")
        print("─" * 80)
        for g in games:
            st = "INSTALLED" if g["installed"] else "IN LIBRARY"
            sz_str = f" ({g['size_on_disk'] / (1024**3):.1f} GB)" if g["installed"] and g.get("size_on_disk") else ""
            print(f"[{g['appid']:7d}] {g['name']:<38} | {g['source']:<22} [{st}{sz_str}]")
        print("─" * 80)
        return

    if args.command == "export":
        appids = None
        if args.all:
            appids = "all"
        elif args.games:
            appids = [int(x.strip()) for x in args.games.split(",") if x.strip()]
        elif args.game:
            appids = [args.game]
        else:
            print("Please specify --all, --games <id1,id2>, or --game <id>.")
            return

        res = export_games(appids=appids, backup_name=args.name, backup_dir=args.out)
        if res["success"]:
            print(f"\n✓ Successfully exported {res['count']} game(s) to:")
            print(f"  {res['path']}")
        else:
            print(f"\n✗ Export failed: {res['error']}")

    elif args.command == "backups":
        b_list = list_backups()
        print(f"\n📦 Available Backups in {DEFAULT_BACKUP_DIR}:")
        print("─" * 80)
        if not b_list:
            print("No backups found.")
        for b in b_list:
            dt = datetime.fromtimestamp(b["mtime"]).strftime("%Y-%m-%d %H:%M:%S")
            sz = f"{b['size'] / 1024:.1f} KB"
            print(f"{b['filename']:<48} {b['count']:2d} games | {sz} | {dt}")
        print("─" * 80)

    elif args.command == "delete":
        res = delete_backup(args.filename)
        if res["success"]:
            print(f"\n✓ Successfully deleted backup: {res['filename']}")
        else:
            print(f"\n✗ Delete failed: {res['error']}")

    elif args.command == "restore":
        if args.file:
            res = import_single_file(args.file)
            if res["success"]:
                print(f"\n✓ Imported {res['name']} ({res['appid']}) as {res['type']}!")
                print("  Restart Steam to refresh your library.")
            else:
                print(f"\n✗ Import failed: {res['error']}")
            return

        appids = None
        if args.all:
            appids = "all"
        elif args.games:
            appids = [int(x.strip()) for x in args.games.split(",") if x.strip()]
        elif args.game:
            appids = [args.game]

        bpath = args.backup
        if bpath and not os.path.isabs(bpath) and not os.path.exists(bpath):
            bpath = os.path.join(DEFAULT_BACKUP_DIR, bpath)

        res = restore_games(backup_path=bpath, appids=appids)
        if res["success"]:
            print(f"\n✓ Successfully restored {res['restored_count']} game(s) from:")
            print(f"  {res['backup_path']}")
            for g in res["games"]:
                print(f"  + [{g['appid']}] {g['name']}")
            print("\n→ Restart Steam to refresh your library.")
        else:
            print(f"\n✗ Restore failed: {res['error']}")

    elif args.command == "inject":
        ok, msg = inject_into_steam()
        if ok:
            print("[✓] Successfully injected Library Manager into running Steam client!")
        else:
            print(f"[✗] Injection failed: {msg}")

    elif args.command == "daemon" or args.command == "gui":
        run_daemon()

if __name__ == "__main__":
    main()
